# Version control
.git/
.gitignore

# GitHub / docs
.github/
images/
*.md
# ...but the Dockerfile needs README.md: pyproject.toml sets readme = "README.md",
# which pip reads during `pip install .`.
!README.md

# Python cache
__pycache__/
*.py[cod]
*.pyo
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Tests
tests/
test_*.py

# Docker files themselves (don't recurse)
Dockerfile
docker-compose.yml
.dockerignore

# OS / editor noise
.DS_Store
*.swp
*.swo
